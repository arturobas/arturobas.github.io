---
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import { sections } from "../config/sections";

const links = sections.filter((s) => s.enabled && s.showInNav);
---

<Base>
  <Hero />
  <nav class="section home-links" aria-label="Secciones del portafolio">
    <ul>
      {
        links.map((item) => (
          <li>
            <a href={`/${item.slug}`}>{item.navLabel}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</Base>
