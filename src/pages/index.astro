---
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import { sections } from "../config/sections";

const links = sections.filter((s) => s.enabled && s.showInNav);
const base = import.meta.env.BASE_URL;
---

<Base>
  <Hero />
  <nav class="mx-auto max-w-[1200px] px-6 pb-24" aria-label="Secciones del portafolio">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        links.map((item) => (
          <li>
            <a
              href={`${base}${item.slug}`}
              class="glass-panel glow-button block px-6 py-5 font-mono text-body-sm text-on-surface"
            >
              {item.navLabel}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Base>
