---
import "../styles/global.css";
import { site } from "../data/site";
import { sections } from "../config/sections";

interface Props {
  title?: string;
}

const { title = `${site.name} — ${site.role}` } = Astro.props;
const navItems = sections.filter((s) => s.enabled && s.showInNav);
const base = import.meta.env.BASE_URL;
const normalize = (p: string) => p.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <header
      class="fixed inset-x-0 top-0 z-50 border-b border-outline-variant/20 bg-surface/80 backdrop-blur-xl"
    >
      <div class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-4">
        <a
          class="font-mono text-sm font-bold tracking-tight text-primary"
          href={base}
          aria-current={currentPath === normalize(base) ? "page" : undefined}
        >
          {site.name}
        </a>
        <nav>
          <ul class="flex gap-8 font-mono text-body-sm">
            {
              navItems.map((item) => {
                const href = `${base}${item.slug}`;
                return (
                  <li>
                    <a
                      href={href}
                      class="text-on-surface-variant transition-colors hover:text-primary aria-[current=page]:border-b-2 aria-[current=page]:border-primary aria-[current=page]:pb-1 aria-[current=page]:font-semibold aria-[current=page]:text-primary"
                      aria-current={currentPath === href ? "page" : undefined}
                    >
                      {item.navLabel}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>
    <main class="flex-grow pt-20">
      <slot />
    </main>
    <footer class="border-t border-outline-variant/20 bg-surface-container-lowest">
      <div
        class="mx-auto flex max-w-[1200px] flex-col items-center gap-6 px-6 py-12 md:flex-row md:justify-between"
      >
        <div class="flex flex-col items-center gap-2 md:items-start">
          <span class="font-mono text-body-sm text-primary">{site.name}</span>
          <span class="font-mono text-label-caps text-on-surface-variant">
            © {new Date().getFullYear()} {site.name}
          </span>
        </div>
        <nav>
          <ul class="flex flex-wrap justify-center gap-6 font-mono text-label-caps uppercase">
            {
              site.socials.map((s) => (
                <li>
                  <a
                    href={s.url}
                    class="text-on-surface-variant transition-colors hover:text-secondary"
                    target={s.url.startsWith("http") ? "_blank" : undefined}
                    rel={s.url.startsWith("http") ? "noopener noreferrer" : undefined}
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
