---
import { skillGroups } from "../../data/skills";
import { sectionNumber } from "../../config/sections";
---

<section id="skills" class="mx-auto max-w-[1200px] px-6 py-16 md:py-30">
  <div class="mb-12">
    <span class="font-mono text-label-caps text-primary">
      {sectionNumber("skills")}. // ARSENAL TÉCNICO
    </span>
    <h2 class="mt-2 text-headline-md text-on-surface">Competencias principales</h2>
  </div>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      skillGroups.map((group) => (
        <div class="glass-panel flex flex-col gap-4 p-6">
          <h3 class="flex items-center gap-2 font-mono text-body-sm font-semibold uppercase tracking-wide text-primary">
            <span class="material-symbols-outlined text-[18px]">code</span>
            {group.category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="pill">{item}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
