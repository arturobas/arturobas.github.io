---
import { site } from "../../data/site";
import { sectionNumber } from "../../config/sections";
import MacDots from "../ui/MacDots.astro";

const emailEntry = site.socials.find((s) => s.url.startsWith("mailto:"));
const email = emailEntry?.url.replace("mailto:", "") ?? "";
const otherSocials = site.socials.filter((s) => s !== emailEntry);
---

<section id="contact" class="mx-auto max-w-[1200px] px-6 py-16 md:py-30">
  <div class="mb-16">
    <span class="font-mono text-label-caps text-secondary">
      // {sectionNumber("contact")}. Contacto
    </span>
    <h2 class="mt-2 max-w-2xl text-display-lg-mobile font-extrabold tracking-tight text-on-surface">
      Construyamos algo juntos.
    </h2>
    <p class="mt-6 max-w-2xl text-body-lg text-on-surface-variant">
      Estoy abierto a nuevas oportunidades. Si tienes una pregunta o solo quieres saludar,
      con gusto te responderé.
    </p>
  </div>
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <div class="glass-panel relative overflow-hidden p-8 md:p-12">
        <MacDots />
        <form
          action={`mailto:${email}`}
          method="post"
          enctype="text/plain"
          class="mt-8 space-y-6"
        >
          <div class="grid gap-6 md:grid-cols-2">
            <div class="space-y-2">
              <label for="name" class="block font-mono text-label-caps uppercase text-on-surface-variant">
                Nombre
              </label>
              <input id="name" name="name" type="text" required placeholder="Tu nombre" class="glass-input" />
            </div>
            <div class="space-y-2">
              <label for="email" class="block font-mono text-label-caps uppercase text-on-surface-variant">
                Email
              </label>
              <input id="email" name="email" type="email" required placeholder="tu@email.com" class="glass-input" />
            </div>
          </div>
          <div class="space-y-2">
            <label for="subject" class="block font-mono text-label-caps uppercase text-on-surface-variant">
              Asunto
            </label>
            <input id="subject" name="subject" type="text" placeholder="Propuesta de proyecto" class="glass-input" />
          </div>
          <div class="space-y-2">
            <label for="message" class="block font-mono text-label-caps uppercase text-on-surface-variant">
              Mensaje
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              placeholder="Hola, me gustaría hablar sobre..."
              class="glass-input resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="glow-button flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-8 py-4 font-mono text-body-sm font-bold tracking-wide text-on-primary sm:w-auto"
          >
            Enviar mensaje
            <span class="material-symbols-outlined text-[18px]">send</span>
          </button>
        </form>
      </div>
    </div>
    <div class="flex flex-col gap-8 lg:col-span-5">
      <div class="glass-panel flex flex-col gap-6 p-8">
        <h3 class="text-headline-md text-on-surface">Contacto directo</h3>
        {
          email && (
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 rounded-lg bg-surface-container p-3 text-primary">
                <span class="material-symbols-outlined">mail</span>
              </div>
              <div>
                <p class="mb-1 font-mono text-label-caps uppercase text-on-surface-variant">Email</p>
                <a href={`mailto:${email}`} class="text-body-lg text-on-surface transition-colors hover:text-primary">
                  {email}
                </a>
              </div>
            </div>
          )
        }
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 rounded-lg bg-surface-container p-3 text-primary">
            <span class="material-symbols-outlined">location_on</span>
          </div>
          <div>
            <p class="mb-1 font-mono text-label-caps uppercase text-on-surface-variant">Ubicación</p>
            <p class="text-body-lg text-on-surface">{site.location}</p>
          </div>
        </div>
      </div>
      {
        otherSocials.length > 0 && (
          <div class="glass-panel flex flex-col gap-4 p-8">
            <h3 class="text-lg font-bold text-on-surface">Redes</h3>
            <div class="flex flex-col gap-2">
              {otherSocials.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-4 rounded-lg border border-transparent p-3 transition-colors hover:border-outline-variant/30 hover:bg-surface-container-high"
                >
                  <span class="flex-grow font-mono text-body-sm text-on-surface transition-colors group-hover:text-primary">
                    {s.label}
                  </span>
                  <span class="material-symbols-outlined text-[16px] text-outline-variant opacity-0 transition-opacity group-hover:opacity-100">
                    arrow_outward
                  </span>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
