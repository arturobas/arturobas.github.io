---
import { getCollection, render } from "astro:content";
import { sectionNumber } from "../../config/sections";

const experiences = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(
  experiences.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<section id="experience" class="mx-auto max-w-[1200px] px-6 py-16 md:py-30">
  <div class="mb-12">
    <span class="font-mono text-label-caps text-primary">
      {sectionNumber("experience")}. // TRAYECTORIA
    </span>
    <h2 class="mt-2 text-headline-md text-on-surface">Experiencia profesional</h2>
  </div>
  {
    rendered.length === 0 ? (
      <p class="italic text-on-surface-variant">
        Agrega experiencia en src/content/experience/
      </p>
    ) : (
      <ol class="relative flex flex-col gap-8 border-l border-outline-variant/30 pl-8">
        {rendered.map(({ entry, Content }) => {
          const current = !entry.data.endDate;
          return (
            <li class="relative">
              <span
                class={`mac-dot absolute -left-[calc(2rem+5px)] top-1.5 ${
                  current
                    ? "bg-secondary shadow-[0_0_10px_rgba(78,222,163,0.6)]"
                    : "bg-outline-variant"
                }`}
              />
              <div class="glass-panel p-6">
                <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
                  <div>
                    <h3 class="text-lg font-bold text-primary">{entry.data.role}</h3>
                    <p class="mt-1 font-mono text-body-sm text-on-surface-variant">
                      {entry.data.organization}
                      {entry.data.location ? ` — ${entry.data.location}` : ""}
                    </p>
                  </div>
                  <span class="inline-block rounded-full border border-outline-variant px-3 py-1 font-mono text-body-sm text-on-surface-variant">
                    {entry.data.startDate} — {entry.data.endDate ?? "Presente"}
                  </span>
                </div>
                <div class="mt-4 space-y-2 text-body-sm text-on-surface-variant [&_ul]:list-disc [&_ul]:pl-5">
                  <Content />
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    )
  }
</section>
