---
import { site } from "../../data/site";
import { sectionNumber } from "../../config/sections";
import MacDots from "../ui/MacDots.astro";

const base = import.meta.env.BASE_URL;
---

<section id="about" class="mx-auto grid max-w-[1200px] gap-12 px-6 py-16 md:grid-cols-2 md:py-30">
  <div class="order-2 md:order-1">
    {
      site.avatarUrl ? (
        <img
          src={`${base}${site.avatarUrl}`}
          alt={site.name}
          class="aspect-square w-full rounded-xl object-cover"
        />
      ) : (
        <div class="glass-panel flex aspect-square w-full items-center justify-center">
          <span class="material-symbols-outlined text-6xl text-on-surface-variant/40">
            person
          </span>
        </div>
      )
    }
  </div>
  <div class="order-1 flex flex-col gap-6 md:order-2">
    <div>
      <span class="font-mono text-label-caps text-primary">
        {sectionNumber("about")}. // SOBRE MÍ
      </span>
      <h2 class="mt-2 text-headline-md text-on-surface">Sobre mí</h2>
    </div>
    <div class="glass-panel p-8">
      <MacDots />
      <p class="mt-4 text-body-lg text-on-surface-variant">{site.about}</p>
      <p class="mt-4 flex items-center gap-2 font-mono text-body-sm text-on-surface-variant">
        <span class="material-symbols-outlined text-[18px]">location_on</span>
        {site.location}
      </p>
    </div>
  </div>
</section>
